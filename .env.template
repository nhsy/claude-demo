# Copy to .env (task init does) and adjust. Never commit .env.
# Dev server to test against. Local `vault server -dev` (task dev:up) and the Community
# container (task up) both listen on 8250; the Enterprise container (task up:ent) on 8260.
export VAULT_ADDR=http://127.0.0.1:8250
export VAULT_DEV_ROOT_TOKEN=root
export VAULT_DEV_PORT=8250
export VAULT_CE_PORT=8250
export VAULT_ENT_PORT=8260
export VAULT_CE_IMAGE=docker.io/hashicorp/vault:2.1.1
export VAULT_ENT_IMAGE=docker.io/hashicorp/vault-enterprise:2.1.1-ent
# Enterprise only (task up:ent)
export VAULT_LICENSE=
export CONTAINER_CLI=docker
