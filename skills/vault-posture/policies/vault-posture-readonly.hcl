# vault-posture-readonly: the base policy the vault-posture skill's token needs.
# GENERATED by scripts/gen_policies.py (task policies): do not edit by hand.
#
# Grants read/list on exactly the endpoints vault_posture.py reads for audit, quotas,
# security and roles. PKI reads are in the opt-in add-on vault-posture-pki-reader.
# Load once in the ROOT namespace and mint a short-lived token per session:
#   vault policy write vault-posture-readonly vault-posture-readonly.hcl
#   vault token create -policy=vault-posture-readonly -no-default-policy -orphan -ttl=1h
#
# Namespace-local rules repeat for the root namespace and five nesting levels, and
# mount-relative rules for mount paths of one to three segments (auth/k8s/prod/, pki/int/).

# ---- root namespace (cluster-wide)

# Token validation (the script calls lookup-self before any other read)
path "auth/token/lookup-self" {
  capabilities = ["read"]
}

# Quotas
path "sys/quotas/config" {
  capabilities = ["read"]
}
path "sys/quotas/rate-limit/*" {
  capabilities = ["read", "list"]
}

# Enterprise only; Community answers 404 and the scope is reported as unsupported
path "sys/quotas/lease-count/*" {
  capabilities = ["read", "list"]
}

# Seal-key operation status (the script keeps started/progress/required only)
path "sys/generate-root/attempt" {
  capabilities = ["read"]
}
path "sys/generate-recovery-token/attempt" {
  capabilities = ["read"]
}
path "sys/rekey/init" {
  capabilities = ["read"]
}
path "sys/rekey-recovery-key/init" {
  capabilities = ["read"]
}

# Barrier key and plugins
